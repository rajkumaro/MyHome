build/
dist/
client/build/

# Environment files (never commit real secrets)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Keep example and template files
!env/.env.example
!env/.env.development
!env/.env.staging
!env/.env.production

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE / Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Test coverage
coverage/
.nyc_output/

# Backup files
*.tar.gz
*.bak
.previous_backend_image
.previous_frontend_image
.previous_tag

# Temporary files
tmp/
temp/
