# =============================================================================
# MyHome - Staging Environment Variables
# =============================================================================

NODE_ENV=staging
PORT=5000
CLIENT_URL=https://staging.myhome.com

MONGODB_URI=mongodb+srv://<staging_user>:<staging_password>@<cluster>.mongodb.net/myhome_staging?retryWrites=true&w=majority
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=staging_mongo_password_change_me

REDIS_URL=redis://redis:6379
REDIS_PASSWORD=staging_redis_password_change_me

JWT_SECRET=staging_jwt_secret_change_this_before_use
JWT_EXPIRE=7d

STRIPE_PUBLIC_KEY=pk_test_your_staging_stripe_public_key
STRIPE_SECRET_KEY=sk_test_your_staging_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_staging_stripe_webhook_secret

SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_api_key
EMAIL_FROM=staging@myhome.com

AWS_ACCESS_KEY_ID=your_staging_aws_access_key
AWS_SECRET_ACCESS_KEY=your_staging_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=myhome-staging-uploads

SENTRY_DSN=https://your_sentry_dsn@sentry.io/staging_project_id

REACT_APP_API_URL=https://api-staging.myhome.com
REACT_APP_SOCKET_URL=https://api-staging.myhome.com
REACT_APP_STRIPE_PUBLIC_KEY=pk_test_your_staging_stripe_public_key

S3_BACKUP_BUCKET=myhome-staging-backups
BACKUP_RETENTION_DAYS=7
