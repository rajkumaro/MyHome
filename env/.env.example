# =============================================================================
# MyHome - Environment Variables Example
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env files with real credentials to version control.
# =============================================================================

# ── Application ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

# ── MongoDB ────────────────────────────────────────────────────────────────────
# Local MongoDB
MONGODB_URI=mongodb://localhost:27017/myhome

# MongoDB Atlas (uncomment and fill in for production)
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/myhome?retryWrites=true&w=majority

# MongoDB Docker credentials (used in docker-compose)
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=change_this_password

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=change_this_redis_password

# ── JWT Authentication ─────────────────────────────────────────────────────────
# Generate a strong random secret: openssl rand -base64 64
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# ── Stripe Payments ────────────────────────────────────────────────────────────
STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# ── Email (Nodemailer) ─────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=noreply@myhome.com

# ── AWS (for S3 file uploads) ──────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=myhome-uploads

# ── Sentry Error Tracking ──────────────────────────────────────────────────────
SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id

# ── Frontend Environment ───────────────────────────────────────────────────────
REACT_APP_API_URL=http://localhost:5000
REACT_APP_SOCKET_URL=http://localhost:5000
REACT_APP_STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key

# ── S3 Backup ──────────────────────────────────────────────────────────────────
S3_BACKUP_BUCKET=myhome-backups
BACKUP_RETENTION_DAYS=7
