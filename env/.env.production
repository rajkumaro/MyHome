# =============================================================================
# MyHome - Production Environment Variables
# =============================================================================
# IMPORTANT: Replace ALL placeholder values before deploying to production.
# Store this file securely and never commit it to version control.
# =============================================================================

NODE_ENV=production
PORT=5000
CLIENT_URL=https://myhome.com

MONGODB_URI=mongodb+srv://<prod_user>:<prod_password>@<cluster>.mongodb.net/myhome?retryWrites=true&w=majority
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=CHANGE_THIS_STRONG_PASSWORD

REDIS_URL=redis://redis:6379
REDIS_PASSWORD=CHANGE_THIS_STRONG_REDIS_PASSWORD

JWT_SECRET=CHANGE_THIS_TO_A_VERY_LONG_RANDOM_STRING_AT_LEAST_64_CHARS
JWT_EXPIRE=7d

STRIPE_PUBLIC_KEY=pk_live_your_live_stripe_public_key
STRIPE_SECRET_KEY=sk_live_your_live_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_live_stripe_webhook_secret

SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_production_sendgrid_api_key
EMAIL_FROM=noreply@myhome.com

AWS_ACCESS_KEY_ID=your_production_aws_access_key
AWS_SECRET_ACCESS_KEY=your_production_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=myhome-production-uploads

SENTRY_DSN=https://your_sentry_dsn@sentry.io/production_project_id

REACT_APP_API_URL=https://api.myhome.com
REACT_APP_SOCKET_URL=https://api.myhome.com
REACT_APP_STRIPE_PUBLIC_KEY=pk_live_your_live_stripe_public_key

S3_BACKUP_BUCKET=myhome-production-backups
BACKUP_RETENTION_DAYS=30
